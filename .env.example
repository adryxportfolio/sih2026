# =============================================================================
#  SAMIKSHA  ·  Environment Configuration
#  Copy to `.env` and fill in. NEVER commit `.env`.
# =============================================================================
#
#  SECURITY MODEL — read this before adding any key
#  -----------------------------------------------------------------
#  Vars prefixed EXPO_PUBLIC_ are INLINED INTO THE ANDROID APK at build
#  time. An APK is trivially decompilable (`apktool d app.apk`), so anything
#  with that prefix must be considered PUBLIC KNOWLEDGE.
#
#  ✅ SAFE  as EXPO_PUBLIC_ : Supabase URL, anon/publishable key (RLS-guarded)
#  ❌ NEVER as EXPO_PUBLIC_ : service_role key, OpenRouter key, YouTube key
#
#  Server-only secrets (Section 2) are uploaded to Supabase Edge Function
#  secrets via `npm run secrets:push` and never enter the mobile bundle.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. CLIENT-SAFE  →  compiled into the APK, protected by Row Level Security
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# 2. SERVER-ONLY  →  Supabase Edge Function secrets. NEVER in the app.
# -----------------------------------------------------------------------------

# Supabase admin key. Bypasses ALL Row Level Security. Guard like a password.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — the AI engine.  https://openrouter.ai/keys
OPENROUTER_API_KEY=

# YouTube Data API v3 — free 10,000 units/day.
# console.cloud.google.com → enable "YouTube Data API v3" → create API key
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# 3. MODEL  —  one model, everywhere
# -----------------------------------------------------------------------------
# deepseek/deepseek-v4-flash
#   1M context  · ~$0.09/M in · strict JSON-schema structured output
#   A 150-page handbook fits in a single call, so quiz generation never has to
#   stitch chunks together. Generating a 20-question quiz costs well under a
#   cent, which is what makes on-demand generation viable at workforce scale.
#
#   Text only — scanned pages escalate to MODEL_VISION below.
MODEL_PRIMARY=deepseek/deepseek-v4-flash

# Vision specialist — used ONLY for scanned pages with no text layer.
# ~5x the cost of the text model, so it runs only after the cheap path fails.
MODEL_VISION=moonshotai/kimi-k2.5

# -----------------------------------------------------------------------------
# 4. FEATURE FLAGS
# -----------------------------------------------------------------------------
# mock = seeded FRAC simulator (demo-safe) · live = real iGOT/Sunbird endpoint
IGOT_MODE=mock
IGOT_BASE_URL=
IGOT_API_KEY=

# Samiksha AI Workspace (desktop agent platform). The mobile mascot opens this.
# Point at the machine running the workspace; blank hides the in-app view.
EXPO_PUBLIC_WORKSPACE_URL=
